######
## The server is now using nginx with an htaccess compat module.
## See: https://github.com/yezhiyi9670/htaccess-for-nginx-fork/tree/cef26822d58d02cbb2035fb62f82a5e362c5135f
######

## <no-index-cache>
## Not supported by the compat module yet. Need rephrasing in nginx config.
## Refer to the same tag in the site configuration.
<Files "index.html">
	Header set Cache-Control "no-cache"
</Files>
## </no-index-cache>

## <no-autoindex>
## Not supported by the compat module yet, but is included in default nginx config.
Options -Indexes
## </no-autoindex>

## <error-document-404>
## Not supported by the compat module yet.
## This directive can be replaced with `error_page 404 /404.html;` in nginx,
## which is included in default nginx config.
ErrorDocument 404 /404.html
## </error-document-404>

## <no-trailing-slash>
## This works on nginx with the compat module, despite the module not supporting DirectorySlash.
DirectorySlash Off
RewriteEngine On
# Strip trailing slashes if you have some
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+[^/])/+$ $1 [L,R=302]
# Try index.html
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^ %{REQUEST_URI}/index.html [L]
# Try index.htm
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.htm -f
RewriteRule ^ %{REQUEST_URI}/index.htm [L]
# Try index.php
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.php -f
RewriteRule ^ %{REQUEST_URI}/index.php [L]
# Eat flaming death (prevent redirect loop)
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ %{REQUEST_URI}/index.html [L,R=403]
## </no-trailing-slash>
